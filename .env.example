BOT_TOKEN=your_bot_token_from_botfather
ADMIN_IDS=123456789,987654321

# Leave RUN_MODE=polling for local testing on your own computer.
# Set RUN_MODE=webhook only when deploying to Render (or similar).
RUN_MODE=polling

# Only needed when RUN_MODE=webhook. This is your Render service's public URL.
# Example: https://telegram-vault-bot.onrender.com
WEBHOOK_URL=

# Render sets PORT automatically - you don't need to set this yourself on Render.
PORT=10000
